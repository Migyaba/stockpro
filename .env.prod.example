# ==========================================
# STOCKPRO - Variables d'environnement PROD
# ==========================================

# Base de données PostgreSQL
POSTGRES_DB=stockpro_prod
POSTGRES_USER=stockpro_user
POSTGRES_PASSWORD=changer_ce_mot_de_passe_ultra_securise

# MinIO (Stockage d'images S3 compatible)
MINIO_ROOT_USER=stockpro_minio_admin
MINIO_ROOT_PASSWORD=changer_ce_mot_de_passe_minio_secret
MINIO_BUCKET_NAME=stockpro-media

# Backend Django
DJANGO_SECRET_KEY=generer_une_cle_secrete_aleatoire_de_plus_de_50_caracteres
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com,backend,localhost

# CORS et CSRF (origines autorisées avec https)
CORS_ALLOWED_ORIGINS=https://stockpro.miguelmissetcho.com,http://localhost
CSRF_TRUSTED_ORIGINS=https://stockpro.miguelmissetcho.com,http://localhost

# Durée de validité des jetons JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Frontend Next.js
# Laisser vide si l'API et le frontend partagent le même domaine via Nginx (recommandé),
# sinon indiquer l'URL publique de l'API (ex: https://api.votre-domaine.com)
NEXT_PUBLIC_API_URL=

# ==========================================
# AlphaPay - Paiement Mobile Money & Cartes
# ==========================================
# Clé secrète API : sk_live_... (ou sk_test_... en bac à sable)
ALPHAPAY_SECRET_KEY=
# Secret de signature du webhook (généré depuis le dashboard AlphaPay)
ALPHAPAY_WEBHOOK_SECRET=
# URL publique du frontend pour la redirection après paiement
FRONTEND_URL=https://stockpro.miguelmissetcho.com

# Emails (réinitialisation de mot de passe)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.miguelmissetcho.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=contact@miguelmissetcho.com
# Mot de passe du compte de messagerie : à renseigner uniquement dans le .env du serveur.
EMAIL_HOST_PASSWORD=
# L'expéditeur doit être l'adresse authentifiée, sinon le serveur SMTP refuse l'envoi.
DEFAULT_FROM_EMAIL=STOCKPRO <contact@miguelmissetcho.com>

# Sécurité : reverse proxies de confiance devant Django, HSTS (0 = désactivé)
DJANGO_NUM_PROXIES=1
DJANGO_SECURE_HSTS_SECONDS=0

# Sécurité de l'admin Django et de la documentation de l'API (/api/docs/,
# réservée aux comptes staff connectés à l'admin).
# URL de l'admin : choisissez un chemin difficile à deviner.
DJANGO_ADMIN_URL=admin/
# Adresses ou réseaux autorisés, séparés par des virgules (vide = tous).
DJANGO_ADMIN_ALLOWED_IPS=
# Durée maximale d'une session, rafraîchissements compris (jours).
JWT_SESSION_MAX_DAYS=30
