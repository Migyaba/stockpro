# Database
POSTGRES_DB=stockpro
POSTGRES_USER=stockpro
POSTGRES_PASSWORD=stockpro

# Backend
DJANGO_SECRET_KEY=generate-a-secure-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
DATABASE_URL=postgres://stockpro:stockpro@127.0.0.1:5433/stockpro
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# JWT (minutes / days)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AlphaPay (Mobile Money)
ALPHAPAY_SECRET_KEY=
ALPHAPAY_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000
