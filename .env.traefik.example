# =================================================================
# STOCKPRO - Fichier .env pour VPS (à placer dans ~/apps/stockpro/.env)
# =================================================================

# Réseau Docker Traefik (vérifier avec: docker network ls)
TRAEFIK_NETWORK_NAME=traefik_default
TRAEFIK_CERTRESOLVER=letsencrypt

# Base de données PostgreSQL dédiée
POSTGRES_DB=stockpro_prod
POSTGRES_USER=stockpro_user
POSTGRES_PASSWORD=Choisir_Un_Mot_De_Passe_Robuste_Postgres

# MinIO existant sur le VPS
# MINIO_ENDPOINT_URL = URL interne Docker que Django utilise pour uploader
MINIO_ENDPOINT_URL=http://minio:9000
# MINIO_PUBLIC_URL = URL publique que les navigateurs utilisent pour afficher les images (ex: https://minio.miguelmissetcho.com)
MINIO_PUBLIC_URL=
MINIO_ACCESS_KEY=votre_user_minio_existant
MINIO_SECRET_KEY=votre_password_minio_existant
MINIO_BUCKET_NAME=stockpro-media

# Backend Django
DJANGO_SECRET_KEY=generer_une_cle_secrete_aleatoire_de_plus_de_50_caracteres

# AlphaPay (paiement des abonnements) — obligatoire en production :
# sans clé, le checkout est refusé ; sans secret, le webhook est refusé.
ALPHAPAY_SECRET_KEY=
ALPHAPAY_WEBHOOK_SECRET=
FRONTEND_URL=https://stockpro.miguelmissetcho.com

# Emails (réinitialisation de mot de passe). Backend SMTP en production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.miguelmissetcho.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=contact@miguelmissetcho.com
# Mot de passe du compte de messagerie : à renseigner uniquement dans le .env du serveur.
EMAIL_HOST_PASSWORD=
# L'expéditeur doit être l'adresse authentifiée, sinon le serveur SMTP refuse l'envoi.
DEFAULT_FROM_EMAIL=STOCKPRO <contact@miguelmissetcho.com>

# Sécurité
# Nombre de reverse proxies devant Django (Traefik = 1, Cloudflare + Traefik = 2).
DJANGO_NUM_PROXIES=1
# HSTS en secondes (0 = désactivé). À activer une fois tout le domaine en HTTPS, ex. 31536000.
DJANGO_SECURE_HSTS_SECONDS=0

# Sécurité de l'admin Django et de la documentation de l'API (/api/docs/,
# réservée aux comptes staff connectés à l'admin).
# URL de l'admin : choisissez un chemin difficile à deviner.
DJANGO_ADMIN_URL=admin/
# Adresses ou réseaux autorisés, séparés par des virgules (vide = tous).
DJANGO_ADMIN_ALLOWED_IPS=
# Durée maximale d'une session, rafraîchissements compris (jours).
JWT_SESSION_MAX_DAYS=30
